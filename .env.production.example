APP_NAME="Harf Adası"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://harf.example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/app/harf-adasi.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Set the actual reverse-proxy IP/gateway; do not use an unrestricted wildcard.
TRUSTED_PROXIES=
HARF_PORT=8086
