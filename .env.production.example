APP_NAME="Harf Adası"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://harf.example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/app/harf-adasi.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Set the actual reverse-proxy IP/gateway; do not use an unrestricted wildcard.
TRUSTED_PROXIES=
HARF_PORT=8086

# Fixed recordings work without provider credentials. Enable only after the
# actual account voice/model and credit limit have been verified.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_REVISION=irem-v4-v1
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_DAILY_CHAR_LIMIT=500
ELEVENLABS_MONTHLY_CHAR_LIMIT=1000
ELEVENLABS_SESSION_DAILY_CHAR_LIMIT=200
ELEVENLABS_IP_DAILY_CHAR_LIMIT=500
